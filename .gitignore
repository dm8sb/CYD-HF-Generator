# Claude Code agent worktrees
.claude/worktrees/

# Measurement artifacts (firmware images, raw data, logs) stay local; protocols messungen/*.md and
# their images and condensed data (messungen/<protocol>/img/, data/) stay tracked
messungen/*/*
!messungen/*/img/
!messungen/*/data/
# Local WiFi credentials for test builds (main.cpp, -DTEST_WIFI=1); never commit.
include/test_wifi_local.h

# Python bytecode and the local code index of the editor tooling (AF27)
__pycache__/
*.pyc
.codegraph/
